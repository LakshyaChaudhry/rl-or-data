# Copy to .env and fill in. Never commit .env.
HF_TOKEN=                          # needed for meta-llama/Llama-3.1-8B-Instruct (gated)
LAMBDA_API_KEY=                    # cloud.lambda.ai → API keys. Lets setup/idle_shutdown.sh TERMINATE (not just shut down) the instance.
RLORDATA_ARTIFACTS=                # durable store for runs/, data/splits, data/samples, configs/locked:
                                   #   /lambda/nfs/<filesystem-name>/rlordata-artifacts   (Lambda persistent filesystem, same region)
                                   #   or s3://bucket/prefix (needs boto3 + AWS creds)
RLORDATA_GPU_RATE_USD_PER_HOUR=    # used only for the cost printout (Lambda 1x H100 SXM on-demand: 4.29 on 2026-09-07)
WANDB_API_KEY=                     # optional; JSONL logging is the source of truth
# Legacy AWS plan (SPEC §11); superseded by Lambda + RLORDATA_ARTIFACTS. Leave blank unless you are on AWS.
RLORDATA_BUCKET=
AWS_REGION=
